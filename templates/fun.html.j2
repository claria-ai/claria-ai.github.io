{% extends "base.html.j2" %}
{% block title %}Claria &mdash; Meet Lucia{% endblock %}
{% block description %}Lucia, Claria's mascot, keeps you company in distraction mode: she woofs, chases socks, eats dekopon and reads the paper while Claria thinks.{% endblock %}
{% block extra_head %}
  <link rel="stylesheet" href="static/demos.css">
{% endblock %}
{% block body %}
  <header class="hero demo-hero">
    <div class="container">
      <a href="index.html" class="demo-back">&larr; Back to Claria</a>
      <h1>Meet Lucia</h1>
      <p class="hero-sub">Clinical writing is heavy work. Turn on distraction mode and Claria&rsquo;s mascot keeps you company below each client workspace.</p>
    </div>
  </header>

  <section>
    <div class="container">

      <div class="demo-featured">
        <div class="demo-card">
          <video controls preload="metadata" poster="img/lucia-meet-poster.jpg">
            <source src="videos/lucia-meet.mp4" type="video/mp4">
          </video>
          <div class="demo-card-body">
            <h3>Say hello</h3>
            <p>Turn her on in Preferences, click her for a silent woof, drop her a sock to chase, and hide her with the &times; whenever you need to focus.</p>
          </div>
        </div>
      </div>

      <div class="demo-grid">

        <div class="demo-card">
          <video controls preload="metadata" poster="img/lucia-watch-and-feed-poster.jpg">
            <source src="videos/lucia-watch-and-feed.mp4" type="video/mp4">
          </video>
          <div class="demo-card-body">
            <h3>Watch and feed</h3>
            <p>In Watch mode she follows your pointer. In Feed mode she eats up to five dekopon, getting a little rounder with each one.</p>
          </div>
        </div>

        <div class="demo-card">
          <video controls preload="metadata" poster="img/lucia-a-day-poster.jpg">
            <source src="videos/lucia-a-day.mp4" type="video/mp4">
          </video>
          <div class="demo-card-body">
            <h3>A day with Lucia</h3>
            <p>She stretches, naps, twirls and skateboards while you work, perks up when you type, and reads the paper while Claria is thinking.</p>
          </div>
        </div>

      </div>

      <p class="fun-note">Lucia is silent, runs entirely on your Mac, and never sees client data. She arrives in Claria 0.36; turn her on under Preferences &rarr; General &rarr; Distraction mode.</p>

    </div>
  </section>

{% endblock %}
{% block footer %}
  <footer>
    <div class="container">
      <p>&copy; {{ site.copyright_year }} Claria &mdash; <a href="{{ site.github_url }}">GitHub</a></p>
    </div>
  </footer>
{% endblock %}
